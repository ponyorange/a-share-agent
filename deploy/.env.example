# 复制为 .env 后按环境填写（服务器本地文件，不进镜像）
#   cp .env.example .env
APP_ENV=production

# MongoDB（用户 / 持仓 / 推荐归档 / 模拟盘）
MONGODB_URI=

# 独立高熵密钥，均至少 32 字节；不得复用。
JWT_SECRET=
LLM_ENCRYPTION_KEY=
LLM_ENCRYPTION_KEY_PREVIOUS=

# 生产必须保持关闭。
DEV_SEED_ENABLED=0
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

# Tushare Pro Token（可选，调用 Tushare 时需要）
TUSHARE_TOKEN=

# CORS 允许来源，多个用逗号分隔；* 表示全部
CORS_ORIGINS=*

# 顾问委员会后台任务（默认关闭；关闭时不会连接 Redis）
COMMITTEE_ENABLED=0

# 外部 Redis：只填主机名/IP，不要填 URL。真实地址和密码只保存在部署机。
# LangGraph checkpoint 需要 Redis Stack（RedisJSON + RediSearch）。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=0
REDIS_DB=0

COMMITTEE_QUEUE_NAME=committee
COMMITTEE_JOB_TIMEOUT=900
COMMITTEE_KEY_PREFIX=sharedata:committee
COMMITTEE_RESULT_TTL=86400
COMMITTEE_FAILURE_TTL=604800
COMMITTEE_LOCK_TTL=300
