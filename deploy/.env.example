# 复制为 .env 后按环境填写（服务器本地文件，不进镜像）
#   cp .env.example .env
APP_ENV=production

# MongoDB（用户 / 持仓 / 推荐归档 / 模拟盘）
MONGODB_URI=

# 独立高熵密钥，均至少 32 字节；不得复用。
JWT_SECRET=
LLM_ENCRYPTION_KEY=
LLM_ENCRYPTION_KEY_PREVIOUS=

# 生产必须保持关闭。
DEV_SEED_ENABLED=0
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

# Tushare Pro Token（可选，调用 Tushare 时需要）
TUSHARE_TOKEN=

# API 到沙箱控制服务的内部鉴权密钥，至少 32 字节并独立生成。
# 示例：openssl rand -hex 32 会生成 32 字节随机值（64 个十六进制字符）。
# 同一个值仅提供给 share-data API 与 sandbox-controller；Runner 永远不能接收。
SANDBOX_TOKEN=

# CORS 允许来源，多个用逗号分隔；* 表示全部
CORS_ORIGINS=*

# 163 SMTP（授权码，非登录密码；真实值只放部署机 .env，勿提交）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
