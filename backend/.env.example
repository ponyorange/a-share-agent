# 复制为 .env 后填写（.env 不会提交到 git）
#   cp .env.example .env
APP_ENV=production

# Tushare Pro Token（https://tushare.pro/register ）
TUSHARE_TOKEN=

# 可选：保留系统/环境代理（默认会清除失效本地代理）
# AKSHARE_USE_SYSTEM_PROXY=0

# 可选：关闭东财 push2 → push2delay 域名改写
# AKSHARE_DISABLE_HOST_REWRITE=0

# MongoDB（顾问用户/持仓/推荐归档/模拟盘）
MONGODB_URI=
# 用于 JWT 签名，并派生 DeepSeek API Key 加密密钥（每人在 Agent 面板自配 Key）
# 至少 32 字节高熵随机值；不得复用其他密钥。
JWT_SECRET=
# 独立于 JWT，可通过 PREVIOUS 在轮换窗口解密旧数据。
LLM_ENCRYPTION_KEY=
LLM_ENCRYPTION_KEY_PREVIOUS=

# 仅本地开发且 APP_ENV 非 production 时允许；已有用户绝不重置。
DEV_SEED_ENABLED=0
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

# 顾问委员会后台任务（默认关闭；关闭时 API 不会连接 Redis）
COMMITTEE_ENABLED=0

# 外部 Redis：仅填主机名/IP，不要填 redis:// URL，避免密码进入日志或异常。
# LangGraph checkpoint setup 需要 Redis Stack（RedisJSON + RediSearch）。
# 真实地址和密码只应放在部署机的 .env/密钥系统中，绝不能提交到版本库。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=0
REDIS_DB=0

# 队列与数据生命周期（秒）；key 前缀用于和同库其他应用隔离。
COMMITTEE_QUEUE_NAME=committee
# 必须至少比 config.yaml 的 graph total_timeout_seconds 大 15 秒。
COMMITTEE_JOB_TIMEOUT=900
COMMITTEE_KEY_PREFIX=sharedata:committee
COMMITTEE_RESULT_TTL=86400
COMMITTEE_FAILURE_TTL=604800
COMMITTEE_LOCK_TTL=300
