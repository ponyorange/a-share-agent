# 复制为 .env 后填写（.env 不会提交到 git）
#   cp .env.example .env
APP_ENV=production

# Tushare Pro Token（https://tushare.pro/register ）
TUSHARE_TOKEN=

# 可选：保留系统/环境代理（默认会清除失效本地代理）
# AKSHARE_USE_SYSTEM_PROXY=0

# 可选：关闭东财 push2 → push2delay 域名改写
# AKSHARE_DISABLE_HOST_REWRITE=0

# MongoDB（顾问用户/持仓/推荐归档/模拟盘）
MONGODB_URI=
# 用于 JWT 签名，并派生 DeepSeek API Key 加密密钥（每人在 Agent 面板自配 Key）
# 至少 32 字节高熵随机值；不得复用其他密钥。
JWT_SECRET=
# 独立于 JWT，可通过 PREVIOUS 在轮换窗口解密旧数据。
LLM_ENCRYPTION_KEY=
LLM_ENCRYPTION_KEY_PREVIOUS=

# 仅本地开发且 APP_ENV 非 production 时允许；已有用户绝不重置。
DEV_SEED_ENABLED=0
DEV_SEED_USERNAME=
DEV_SEED_PASSWORD=

# 163 SMTP（授权码，非登录密码；真实值只放本机/部署机 .env，勿提交）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
